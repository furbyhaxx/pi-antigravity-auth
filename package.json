{
	"name": "@furbyhaxx/pi-antigravity-auth",
	"version": "3.0.12",
	"description": "Google Antigravity provider for Pi: Gemini, Claude and GPT-OSS through Antigravity OAuth",
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.4.3",
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=22.19.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/furbyhaxx/pi-antigravity-auth.git"
	},
	"homepage": "https://github.com/furbyhaxx/pi-antigravity-auth#readme",
	"bugs": {
		"url": "https://github.com/furbyhaxx/pi-antigravity-auth/issues"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"google",
		"antigravity",
		"gemini",
		"claude",
		"oauth"
	],
	"files": [
		"src",
		"docs",
		"CHANGELOG.md",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "bun run typecheck && bun run lint && bun test"
	},
	"dependencies": {
		"@cortexkit/claustrum-client": "0.12.0",
		"@cortexkit/common-auth": "0.26.0",
		"@cortexkit/subc-client": "0.22.5"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@earendil-works/pi-tui": "1.3.0",
		"@types/bun": "1.4.3",
		"typescript": "7.0.2"
	}
}
